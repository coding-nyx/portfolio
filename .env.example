# Server only. Copy to .env.rook.local; never prefix this key with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# First-party Footfall collector: leave blank until the separate HTTPS collector is deployed.
# Local Vite development forwards /api/footfall automatically to 127.0.0.1:5175.
# Example after deployment: https://analytics.example/api/footfall/events
VITE_FOOTFALL_COLLECTOR_URL=
VITE_FOOTFALL_PROPERTY_ID=portfolio
