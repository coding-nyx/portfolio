# Server only. Copy to .env.rook.local; never prefix this key with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Footfall is hosted in a separate Spark project. No collector URL is used.
# VITE_FOOTFALL_ENABLED=true enables production event writes; build:firebase sets it.
# Local development uses only demo-footfall on the Firestore emulator, port 8085.
VITE_FOOTFALL_ENABLED=false
VITE_FOOTFALL_PROPERTY_ID=portfolio
